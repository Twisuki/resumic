// use prisma-next

model User {
  id          Int      @id @default(autoincrement())
  github      String   @unique                  // GitHub login (handle, URL owner 段), 唯一
  name        String                            // GitHub display name (非唯一), 前端展示
  status      String   @default("active")       // active / disabled(暂用 String, prisma-next enum 待验证)
  createdAt   TimestamptzString @default(now())

  // ai 配置
  activeConfigId  String?
  activeConfig    AiConfig?   @relation("ActiveConfig", fields: [activeConfigId], references: [id])

  configs     AiConfig[] @relation("UserConfigs")

  // 头像槽位
  avatars     Avatar[]

  // 简历数组
  resumes     Resume[]
}

model AiConfig {
  id            String   @id
  userId        Int
  label         String                  // 用户命名, 同 user 内唯一
  apiStyle      String                  // "openai" | "anthropic"
  baseUrl       String                  // 用户填的上游 LLM base URL
  model         String                  // 模型名
  encryptedKey  String                  // ai api key
  createdAt     TimestamptzString       @default(now())
  updatedAt     temporal.updatedAtString()

  user          User     @relation("UserConfigs", fields: [userId], references: [id])

  @@unique([userId, label])
  @@index([userId])
}

model Avatar {
  id          Int      @id @default(autoincrement())
  userId      Int
  url         String   @unique                  // 固定公网 URL, 既是展示地址也是 Blob 定位

  user        User     @relation(fields: [userId], references: [id])
}

model Resume {
  id        Int      @id @default(autoincrement())
  userId    Int
  data      Json                              // Resume 类型(jsonb)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user      User     @relation(fields: [userId], references: [id])
}
