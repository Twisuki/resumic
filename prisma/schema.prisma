// use prisma-next

model User {
  id          Int      @id @default(autoincrement())
  github      String   @unique                  // GitHub login (handle, URL owner 段), 唯一
  name        String                            // GitHub display name (非唯一), 前端展示
  status      String   @default("active")       // active / disabled(暂用 String, prisma-next enum 待验证)
  createdAt   TimestamptzString @default(now())

  // AI 配额(每日)
  aiCount     Int      @default(0)
  aiDate      DateString?                        // 上次扣量日期 (YYYY-MM-DD), 跨日重置

  // AI 自配(可选)
  aiKey       String?
  aiModel     String?

  // 头像槽位(用户级, 文件存 Vercel Blob)
  avatars     Avatar[]

  resumes     Resume[]
}

model Avatar {
  id          Int      @id @default(autoincrement())
  userId      Int
  url         String   @unique                  // 固定公网 URL, 既是展示地址也是 Blob 定位

  user        User     @relation(fields: [userId], references: [id])
}

model Resume {
  id        Int      @id @default(autoincrement())
  userId    Int
  data      Json                              // Resume 类型(jsonb)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user      User     @relation(fields: [userId], references: [id])
}
